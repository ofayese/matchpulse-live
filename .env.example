# Keep true for the challenge entry. Real match data is intentionally rejected.
CHALLENGE_SYNTHETIC_ONLY=true

# ---------------------------------------------------------------------------
# Optional Microsoft Foundry enrichment.
#
# The deterministic pipeline is authoritative and works with none of the
# variables below set. Never commit a real key: FOUNDRY_API_KEY is a runtime
# secret only.
# ---------------------------------------------------------------------------

# Azure OpenAI / Microsoft Foundry endpoint, without a trailing slash.
FOUNDRY_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com

# Deployed model name.
FOUNDRY_DEPLOYMENT=YOUR-DEPLOYMENT

# Azure OpenAI API version.
FOUNDRY_API_VERSION=2024-10-21

# Per-request timeout in seconds before the deterministic fallback is used.
FOUNDRY_TIMEOUT_SECONDS=1.4

# Authentication mode: managed_identity (preferred, needs no stored secret)
# or api_key (local hackathon testing only).
FOUNDRY_AUTH_MODE=managed_identity

# Token scope used by the managed identity credential.
FOUNDRY_AZURE_SCOPE=https://cognitiveservices.azure.com/.default

# Maximum number of concurrent model calls. Bounded so one request can never
# fan out without limit.
FOUNDRY_MAX_CONCURRENCY=4

# Process-wide budget of outbound model calls. When it is exhausted the
# service stays on the deterministic narrative.
FOUNDRY_CALL_BUDGET=60

# Runtime secret for the optional API-key path. Leave empty.
FOUNDRY_API_KEY=

# ---------------------------------------------------------------------------
# Optional telemetry. Both are opt-in. With neither set the application
# behaves exactly as if telemetry did not exist, and no metric ever carries an
# arbitrary identifier as a dimension.
# ---------------------------------------------------------------------------

# Application Insights connection string for the optional exporter.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Alternative OpenTelemetry exporter endpoint.
OTEL_EXPORTER_OTLP_ENDPOINT=
